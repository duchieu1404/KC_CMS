<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>Admin Tool<small>Send Message</small></h1>
  <ol class="breadcrumb">
    <li><a href="#"><i class="fa fa-dashboard"></i>Send Message</a></li>
    <li class="active">Admin Tool</li>
  </ol>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="x_content">
        <br />
        <form id="demo-search_form2"
              action="/users/email_list" method="post"
              data-parsley-validate class="form-horizontal form-label-left">
          <!-- === -->
          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">User ID</label>
            <div class="col-md-3 col-sm-9 col-xs-12">
              <input id="searchUserId" name="searchUserId"  class="form-control col-md-5 col-xs-10" type="text" value="<%=search_form.user_id%>">
            </div>

            <div class="col-md-6 col-sm-9 col-xs-12">
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered data-responsive">
          <thead>
          <tr>
           
            <th>Action</th>
            <th>Id</th>
            <th>email_type</th>
            <th>Title</th>
            <th>Content</th>
            <th>time_send</th>
            <th>send_by</th>
            <th>gift</th>
            <th>Data Extention</th>
            <th>expire_time</th>
            <th>is_read</th>
            <th>is_claimed</th>
            <th>is_delete</th>
          </tr>
          </thead>

          <tbody>
          <% listUsers.forEach(function(userInfo) { %>
          <tr id = "dataServerConfig_<%= userInfo.id %>" value_id = "<%= userInfo.id %>" style='color:<%= userInfo.email_type ==0?"black":userInfo.email_type ==1?"green":userInfo.email_type ==2?"orange":userInfo.email_type ==3?"red":"pink"   %>'>
            <th>
              <button type="button" class="btn btn-danger" style = "display:<%=userInfo.is_claimed == 1 ? 'none;': 'block;' %>" data-toggle="modal" data-target=".delete_email-modal-lg" onclick="btnDeleteEmail(<%= userInfo.id %>)">Delete</button>
            </th>
            <th id = "ds_<%= userInfo.id %>_dts_id"><%= userInfo.id %></th>
            <th id = "ds_<%= userInfo.id %>_dts_email_type"><%= userInfo.email_type ==0?"Normal":userInfo.email_type ==1?"Add data":userInfo.email_type ==2?"Important info":userInfo.email_type == 3?"Force Set data":"Auto forceset data"  %> </th>
            <th id = "ds_<%= userInfo.id %>_dts_title"><%= userInfo.title %></th>
            <th id = "ds_<%= userInfo.id %>_dts_content"><%= userInfo.content %></th>
            <th id = "ds_<%= userInfo.id %>_dts_time_send"><%= userInfo.time_send %></th>
            <th id = "ds_<%= userInfo.id %>_dts_send_by"><%= userInfo.sent_by %></th>
            <th id = "ds_<%= userInfo.id %>_dts_gift"><%= userInfo.gift %></th>
            <th id = "ds_<%= userInfo.id %>_dts_data_etx"><%= userInfo.data_etx %></th>
            <th id = "ds_<%= userInfo.id %>_dts_expire_time"><%= userInfo.expire_time %></th>
            <th id = "ds_<%= userInfo.id %>_dts_is_read"><%= userInfo.is_read %></th>
            <th id = "ds_<%= userInfo.id %>_dts_is_claimed"><%= userInfo.is_claimed %></th>
            <th id = "ds_<%= userInfo.id %>_dts_is_delete"><%= userInfo.is_delete %></th>
          </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade delete_email-modal-lg" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Do you want to delete this email?</h4>
        </div>
        <div class="modal-body">

          <form action="/users/delete_email" method="post" id="delete_email-form2" data-parsley-validate class="form-horizontal form-label-left">

            
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Email Id</label>

              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Email Id" id = "delete_edt_Id" name="delete_edt_Id" value="" readonly="readonly">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Type "delete" to confirm </label>
              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="delete" id = "delete_text_confirm" name="delete_text_confirm" value="">
              </div>
            </div>

            <div class="modal-footer">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Close" id = "modalDelete">
              <input type="button" class="btn btn-danger" value="Delete" onclick="btnDeleteEmailConfirm()">
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>

  
  <script>
    var getEmailTypeName = function(email_type){
      switch (email_type) {
        case 0: return "Normal";
        case 1: return "Add data";
        case 2: return "Important info";
        case 3: return "Force Set data";
        case 4: return "Auto forceset data";
      }
    }

    var getEmailColorByType = function(){
      switch (email_type) {
        case 0: return "black";
        case 1: return "green";
        case 2: return "orange";
        case 3: return "red";
        case 4: return "pink";
      }
    }
    

    var btnDeleteEmail = function(email_id){
       $('#delete_edt_Id').val($('#ds_'+email_id+'_dts_id').html());

    }
  
    var btnDeleteEmailConfirm = function()
    {
      if( $('#delete_text_confirm').val() !='delete')
      {
        alert("Please type delete to confirm you want to delete email");
        $('#delete_text_confirm').focus();
        return;
      }

      let user_id_delete =  $('#delete_edt_Id').val();
      $.ajax({
        type: "POST",
        url: '/users/delete_email',
        data: $( "#delete_email-form2" ).serialize(),
        success: function(dataResult,textStatus,jqXHR){
          console.log(dataResult);
          if(dataResult.status ==0)
          {
            $('#dataServerConfig_'+user_id_delete).remove();
            $(".delete_email-modal-lg .close").click()
            alert("Delete success");
          }
          else
          {        
              alert("Error: " +dataResult.msg);
          }
        },
        dataType: 'json'
      });

    }
  </script>

</section>

<% include ../partial/admin_footer.ejs %>