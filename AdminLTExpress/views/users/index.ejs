    var btnDoBanUser = function()
    {
      if( $('#delete_text_confirm').val() !='ok')
      {
        alert("Please type \"ok\" to confirm you want to ban that user");
        $('#delete_text_confirm').focus();
        return;
      }

      let user_id_delete =  $('#delete_edt_Id').val();
      $.ajax({
        type: "POST",
        url: '/users/ban_user',
        data: $( "#delete_user-form2" ).serialize(),
        success: function(dataResult,textStatus,jqXHR){
          console.log(dataResult);
          if(dataResult.status ==0)
          {
            $("#btn_ban_" +user_id_delete).hide()
            $("#btn_unban_"+user_id_delete).show()
            $("#deleteUserModal .close").click()
            alert("Ban success");
          }
        },
        dataType: 'json'
      });
    }
    var btnDoUnBanUser = function()
    {
      if( $('#delete_text_confirm').val() !='ok')
      {
        alert("Please type \"ok\" to confirm you want to unban that user");
        $('#delete_text_confirm').focus();
        return;
      }

      let user_id_delete =  $('#delete_edt_Id').val();
      $.ajax({
        type: "POST",
        url: '/users/unban_user',
        data: $( "#delete_user-form2" ).serialize(),
        success: function(dataResult,textStatus,jqXHR){
          console.log(dataResult);
          if(dataResult.status ==0)
          {
            $("#btn_ban_"+user_id_delete).show()
            $("#btn_unban_"+user_id_delete).hide()
            $("#deleteUserModal .close").click()
            alert("Unban success");
          }
        },
        dataType: 'json'
      });
    }
</script>








