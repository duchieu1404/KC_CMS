      $('#label_check_PN').show();
      $('#check_PN').show();
      reset_add_gift_value();

    } else
    if(currType==3 ){
      $('.email_gift_value').show();
      $('.email_force_set_value').show();
      $('#label_PN').show();
      $('#edt_PN').show();
      $('#label_check_PN').show();
      $('#check_PN').show();
