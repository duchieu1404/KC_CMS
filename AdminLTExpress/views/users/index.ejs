              class="btn btn-danger"
              data-toggle="modal"
              data-target="#deleteUserModal"
              style = "display:<%= (userInfo.is_banned  == null || userInfo.is_banned == 1) ? 'none;': 'block;' %>"
              onclick="btnBanUser(<%= userInfo.id %>)"
              id="btn_ban_<%= userInfo.id %>">Ban</button>
              
              <button type="button"
              class="btn btn-danger"
              data-toggle="modal"
              data-target="#deleteUserModal"
              style = "display:<%=userInfo.is_banned == 0 ? 'none;': 'block;' %>"
              onclick="btnUnBanUser(<%= userInfo.id %>)"
              id ="btn_unban_<%= userInfo.id %>">UnBan</button> -->

            </td>
            <td id = "ds_<%= userInfo.id %>_dts_id"><%= userInfo.id %></td>
            <td id = "ds_<%= userInfo.id %>_dts_login_type"><%= userInfo.login_type==0?"Device":(userInfo.login_type==1?"Facebook":"Apple") %></td>
            <td id="ds_<%= userInfo.id %>_dts_fullname"><%= userInfo.username %></td>
            <td id = "ds_<%= userInfo.id %>_dts_fullname"><%= userInfo.fullname %></td>
            <td id = "ds_<%= userInfo.id %>_dts_whisk"><%= userInfo.gem %></td>
            <td id = "ds_<%= userInfo.id %>_dts_total_cash_out"><%= userInfo.star %></td>
            <td id="ds_<%= userInfo.id %>_dts_money_spent"><%= userInfo.money_spent %></td>
            <td id = "ds_<%= userInfo.id %>_dts_total_card"><%= userInfo.last_device_id %></td>
            <td id = "ds_<%= userInfo.id %>_dts_start_version"><%= userInfo.start_version %></td>
            <td id="ds_<%= userInfo.id %>_dts_total_card"><%= otherInfo["app_version"] %></td>
            <td id="ds_<%= userInfo.id %>_dts_country"><%= otherInfo["country"] %></td>
