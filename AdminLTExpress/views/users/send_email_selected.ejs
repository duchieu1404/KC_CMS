        var emailTypeChanged = function(){
    var currType = $('#edt_MessageType').val();
    if(currType==1 ){
      $('.email_gift_value').show();
      $('.email_force_set_value').hide();
      $('#label_PN').show();
      $('#edt_PN').show();
      $('#label_check_PN').show();
      $('#check_PN').show();
      reset_add_gift_value();

    } else
    if(currType==3 ){
      $('.email_gift_value').show();
      $('.email_force_set_value').show();
      $('#label_PN').show();
      $('#edt_PN').show();
      $('#label_check_PN').show();
      $('#check_PN').show();
      reset_force_set_value();
    }
    else if(currType==4){
      $('.email_gift_value').show();
      $('.email_force_set_value').show();
      $('#label_PN').hide();
      $('#edt_PN').hide();
      $('#label_check_PN').hide();
      $('#check_PN').hide();
      $('#edt_PN').val("");
      reset_force_set_value();
    }
    else {
      $('.email_gift_value').hide();
      $('.email_force_set_value').hide();
      $('#label_PN').show();
      $('#edt_PN').show();
      $('#label_check_PN').show();
      $('#check_PN').show();
    }
    $("label.error").hide();
  }

