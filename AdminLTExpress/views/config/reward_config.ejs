<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>Server Config<small>Configuration</small></h1>
  <ol class="breadcrumb">
    <li><a href="#"><i class="fa fa-dashboard"></i>Configuration</a></li>
    <li class="active" style="color :aqua">Reward config </li>
  </ol>
</section>


<!-- Main content-->
<section class="content">

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <h2>Reward Config</h2>
        <div class="clearfix"></div> 
      </div>

      <div class="box box-info">

        <div class="box-footer">
            <input type="button" data-toggle="modal" data-target=".edit-config-modal-lg" class="btn btn-success" value="Add New Config reward" onclick="onClick_btnAddNewEvent()" />
        </div>

      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered " style="width:100%">
          <thead>
          <tr>
            <th>Action </th>
            <th>id reward</th>
            <th>name reward</th>
            <th>code reward</th>
            <th>value reward</th>
           
          </tr>
          </thead>
          <tbody>
          <% dataConfigs.forEach(function(conf) { %>
          <tr id = "dataServerConfig_<%= conf.id %>">
            <th>
              <button type="button"
                      class="btn btn-primary"
                      data-toggle="modal"delete_event_popup
                      data-target=".edit-config-modal-lg"
                      onclick="btnEditClicked(<%= conf.id_reward %>)"
              >Edit</button>

              <button type="button"
                      class="btn btn-danger"
                      data-toggle="modal"
                      data-target=".delete_user-modal-lg"
                      onclick="btnDeleteEventGcc(<%= conf.id_reward %>)"
              >Delete</button>

            </th>
            <th id = "ds_<%= conf.id_reward %>_dts_id_reward"><%= conf.id_reward %></th>
            <th id="ds_<%= conf.id_reward %>_dts_name_reward"><%= conf.name_reward %></th>
            <th id = "ds_<%= conf.id_reward %>_dts_code_reward"><%= conf.code_reward %></th>
            <th id = "ds_<%= conf.id_reward %>_dts_value_reward"><%= conf.value_reward %></th>
           
          </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade edit-config-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Edit Config</h4>
        </div>


        <div class="modal-body">

          
          <form action="/config/reward_config" method="post" id="demo-form2" data-parsley-validate class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group"> 
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Id reward</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Id" id = "edt_id_reward" name="edt_id_reward" value="" >
              </div>
            </div>
            <div class="form-group">
            
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Name reward</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Name reward" id = "edt_name_reward" name="edt_name_reward" value="" >
              </div>
            </div>
            <div class="form-group">
            
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Code reward</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Code reward" id = "edt_code_reward" name="edt_code_reward" value="" >
              </div>
            </div>
            <div class="form-group">
            
              <label class="control-label col-md-2 col-sm-3 col-xs-4">value reward</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Value reward" id = "edt_value_reward" name="edt_value_reward" value="" >
              </div>
            </div> 
            <div class="modal-footer">
              <input type="submit" class="btn btn-default" data-dismiss="modal" value="Close">
              <input type="submit" class="btn btn-primary" value="Save changes">
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>


 



  <div class="modal fade delete_user-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Do you want to delete this config reward?</h4>
        </div>
        <div class="modal-body">

          <form action="/config/delete_reward_config" method="post" id="delete_user-form2" data-parsley-validate class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Id </label>

              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Version Id" id = "delete_edt_Id" name="delete_edt_Id" value="" readonly="readonly">
              </div>

              <label class="control-label col-md-2 col-sm-3 col-xs-4">Device id</label>

              <div class="col-md-3 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Device id" id = "delete_edt_device_id" name="delete_edt_device_id" value = "0" readonly="readonly">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Type "delete" to confirm </label>
              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="delete" id = "delete_text_confirm" name="delete_text_confirm" value="">
              </div>
            </div>

            <div class="modal-footer">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Close" id = "modalDelete">
              <input type="button" class="btn btn-danger" value="Delete" onclick="btnDoDeleteEventGcc()">
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>


</section>

<script type="text/javascript">

  var btnDeleteEventGcc = function(serverId){
    $('#delete_edt_Id').val($('#ds_'+serverId+'_dts_id').html());
    $('#delete_edt_device_id').val($('#ds_'+serverId+'_dts_device_id').html());
  }

  var btnDoDeleteEventGcc = function(){

    if( $('#delete_text_confirm').val() !='delete'){
      alert("Please type delete to confirm you want to delete that event gcc");
      $('#delete_text_confirm').focus();
      return;
    }

    let user_id_delete =  $('#delete_edt_Id').val();
    $.ajax({
      type: "POST",
      url: '/config/reward_config_delete',
      data: $( "#delete_user-form2" ).serialize(),
      success: function(dataResult,textStatus,jqXHR){
        console.log(dataResult);
        if(dataResult.status ==0){
          $('#dataServerConfig_'+user_id_delete).remove();
          $(".delete_user-modal-lg .close").click()
          alert("Delete success");
        }
      },
      dataType: 'json'
    });
  }
  var btnEditClicked = function(serverId)
  {
    $('#edt_id_reward').val($('#ds_'+serverId+'_dts_id_reward').html());
    $('#edt_name_reward').val($('#ds_'+serverId+'_dts_name_reward').html());
    $('#edt_value_reward').val($('#ds_'+serverId+'_dts_value_reward').html());
    $('#edt_code_reward').val($('#ds_'+serverId+'_dts_code_reward').html()); 

  }

  var onClick_btnAddNewEvent = function()
  {
     $('#edt_id_reward').val(-1);
    $('#edt_name_reward').val('');
    $('#edt_value_reward').val('');
    $('#edt_code_reward').val('');
}

var btnInsertTestDataClicked = function()
{
  console.log("btnInsertTestDataClicked");
  $.ajax({
    type: "POST",
    url: '/config/reward_config_insert_test_data',
    data: $("#event-ct-insert-test-data-form").serialize(),
    success: function (dataResult, textStatus, jqXHR) {
      console.log(dataResult);
      if (dataResult.status == 0) {
        $(".event-ct-insert-test-data-modal-lg .close").click()
        alert("success");
      }
    },
    dataType: 'json'
  });
}
var btnAddNewScoreClicked = function()
{
    console.log("btnAddNewScoreClicked");
    $.ajax({
      type: "POST",
      url: '/config/reward_config_add_score',
      data: $("#reward_config_add_score-form").serialize(),
      success: function (dataResult, textStatus, jqXHR) {
        console.log(dataResult);
        if (dataResult.status == 0) {
          $(".event-ct-add-score-modal-lg .close").click()
          alert("Add score success");
        }
      },
      dataType: 'json'
    });
}
var getCountByName= function(type)
{
  switch(parseInt(type))
  {
     case 1:
     return 'LIKE';
    case 2:
      return 'DISH';
    case 3:
      return 'COIN';
    case 4:
      return 'COMBOX_MAX';
    case 5:
      return 'CUSTOMER';
    case 6:
      return 'DRINK';
    case 7:
      return 'STAR';
    case 8:
      return 'TIP';
    case 9:
      return 'COMBO';
    case 10:
      return 'LEVEL_NO_BURN';
    case 11:
      return 'LEVEL_NO_TRASH';
    case 12:
      return 'LEVEL_NO_CUS_LEAVE';
  }
}
</script>



<% include ../partial/admin_footer.ejs %>