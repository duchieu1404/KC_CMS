  <div class="modal fade event-ct-add-score-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
  
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Add Score Event</h4>
        </div>
        <div class="modal-body">
  
          <form action="/config/event_champion_tournament_add_score" method="post" id="event_champion_tournament_add_score-form" data-parsley-validate
            class="form-horizontal form-label-left">
  
            <!-- === -->
  
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">user_id</label>
  
              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="user_id" id="edt_user_id" name="edt_user_id"
                  value="">
              </div>
            </div>
              <div class="form-group">
                <label class="control-label col-md-2 col-sm-3 col-xs-4">event_id</label>
                <div class="col-md-6 col-sm-9 col-xs-12">
                  <input type="text" class="form-control" placeholder="event_id" id="edt_event_id" name="edt_event_id"
                    value="">
                </div>
              </div>

                <div class="form-group">
                  <label class="control-label col-md-2 col-sm-3 col-xs-4">score</label>
                  <div class="col-md-6 col-sm-9 col-xs-12">
                    <input type="text" class="form-control" placeholder="score" id="edt_score" name="edt_score"
                      value="">
                  </div>
                </div>

            <div class="modal-footer">
              <input type="button" class="btn btn-primary" value="Add" onclick="btnAddNewScoreClicked()">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Cancel">
            </div>
          </form>
  
        </div>
      </div>
    </div>
  </div>

  <!-- event ct insert test data form -->

  <div class="modal fade event-ct-insert-test-data-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
  
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Insert Test Data</h4>
        </div>
        <div class="modal-body">
  
          <form action="/config/event_champion_tournament_insert_test_data" method="post" id="event-ct-insert-test-data-form" data-parsley-validate
            class="form-horizontal form-label-left">
  
            <!-- === -->
  
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">event_id</label>
  
              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="event_id" id="edt_event_id" name="edt_event_id"
                  value="">
              </div>
            </div>
