<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1> Change Log Event Royal Pass </h1>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="x_content">
        <br />
        <form action="/config/change_log_event_royal_pass" method="post"
              data-parsley-validate class="form-horizontal form-label-left">
              <!-- let search_form = {
                user_id: req.body.user_id,
                start_time: req.body.start_time ? req.body.start_time   : Date.now,
                end_time : req.body.end_time ? req.body.end_time : Date.now,
                page_size: req.body.searchPageSize,
                page: req.body.page || 0
            } -->
          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">User_id</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchUserId" name="searchUserId"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.user_id%>">
            </div>
            <label class="control-label col-md-2 col-sm-3 col-xs-4">Page size</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchPageSize" name="searchPageSize"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.page_size || 10%>">
            </div>
          </div>

          <div class="form-group">
            <div class="col-md-6 col-sm-9 col-xs-12">
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered" style="width:100%">
          <thead>
            <tr>
              <th>No</th>
              <th>User Id</th>
              <th>Event Id</th>
               <th>Step</th>
               <th>Time Client</th>
               <th>Current Score</th>
              <th>type</th>
              <th>Action</th>
              <th>Action Values</th>
              <th>Time Server</th>

            </tr>
          </thead>
          <tbody>
          <% let count = 1; %>
          <% listChangeLogs.forEach(function(listChangeLog) { %>
            <tr>
              <td><%=count++%></td>
              
              <td><%= listChangeLog.user_id %></td>
              <td><%= listChangeLog.event_id %></td>
              <td><%= listChangeLog.step %></td>
              <td><%= listChangeLog.time_client %></td>
              <td><%= listChangeLog.current_score %></td>
              <td><%= listChangeLog.type %></td>
              <td><%= listChangeLog.action %></td>
              <td><%= listChangeLog.action_values %></td> 
              <td><%= listChangeLog.time_server %></td> 
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

 

<% include ../partial/admin_footer.ejs %>