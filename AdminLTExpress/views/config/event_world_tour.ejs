<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>Server Config<small>Configuration</small></h1>
  <ol class="breadcrumb">
    <li><a href="#"><i class="fa fa-dashboard"></i>Configuration</a></li>
    <li class="active">Event popup</li>
  </ol>
</section>




<!-- Main content-->
<section class="content">

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="box box-info">
        <div class="box-header with-border">
          <h3 class="box-title">Search Event Popup Form</h3>
        </div>

        <div class="box-footer">
          <div>
            <input type="button" data-toggle="modal" data-target=".edit-config-modal-lg" class="btn btn-success"
              value="Add Event" onclick="onClick_btnAddNewEvent()" />
            <input type="button" data-toggle="modal" data-target=".event-world-tour-insert-test-data-modal-lg"
              class="btn btn-info" value="Insert Test Data" />
            <input type="button" data-toggle="modal" data-target=".event-world-tour-insert-test-data-me-modal-lg"
              class="btn btn-info" value="Insert Test Data Me" />
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered" style="width:100%">
          <thead>
            <tr>
              <th>Action </th>
              <th>Id</th>
              <th>Status</th>
              <th>Time From</th>
              <th>Time To</th>
              <th>Time Show From</th>
              <th>Time Show To</th>
              <th>Evt Copy</th>
              <th>Event Popup Ids</th>
              <th>Rests </th>
              <th>File_Url</th>
              <th>File_Version</th> 
            </tr>
          </thead>
          <tbody>
            <% dataConfigs.forEach(function(conf) 
          {
            var getCountByName = function (type) 
            {
              switch (parseInt(type)) {
                case 1:
                  return 'Customers_Served';
                case 2:
                  return 'Dishes_Served';
                case 3:
                  return 'Star_Won';
                case 4:
                  return 'Coin_Earned';
                case 5:
                  return 'Daily_Quest';
                case 6:
                  return 'Tips_Earned';
                case 7:
                  return 'Win_Level_Without_Trash';
                case 8:
                  return 'Win_Level_Without_Burning';
                case 9:
                  return 'Win_Level_Without_Cus_Left';
                case 10:
                  return 'Drink_Served';
                  default: 
                  return 'None';
              }
            }
                    
            %>

            <tr id="dataServerConfig_<%= conf.id %>">
              <th>
                <button type="button" class="btn btn-primary" data-toggle="modal" delete_event_popup
                  data-target=".edit-config-modal-lg" onclick="btnEditClicked(<%= conf.id %>)">Edit</button>

                <button type="button" class="btn btn-danger" data-toggle="modal" data-target=".delete_user-modal-lg"
                  onclick="btnDeleteEvent(<%= conf.id %>)">Delete</button>

              </th>
              <th id="ds_<%= conf.id %>_dts_id"><%= conf.id %></th>
              <th id="ds_<%= conf.id %>_dts_status"><%= conf.status %></th>
              <th id="ds_<%= conf.id %>_dts_time_from"><%= conf.time_from %></th>
              <th id="ds_<%= conf.id %>_dts_time_to"><%= conf.time_to %></th>
              <th id="ds_<%= conf.id %>_dts_time_show_from"><%= conf.show_from %></th>
              <th id="ds_<%= conf.id %>_dts_time_show_to"><%= conf.show_to %></th>
              <th id="ds_<%= conf.id %>_dts_evt_copy"><%= conf.evt_copy %></th>
              <th id="ds_<%= conf.id %>_dts_popup_ids"><%= conf.popup_ids %></th>
              <th id="ds_<%= conf.id %>_dts_event_data"><%= conf.event_data %></th>
              <th id="ds_<%= conf.id %>_dts_file_url"><%= conf.file_url %></th>
              <th id="ds_<%= conf.id %>_dts_file_version"><%= conf.file_version %></th>

            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal fade edit-config-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Edit Config</h4>
        </div>


        <div class="modal-body">


          <form action="/config/event_world_tour" method="post" id="demo-form2" data-parsley-validate
            class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group">

              <label class="control-label col-md-2 col-sm-3 col-xs-4">Id</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Id" id="edt_id" name="edt_id" value=""
                  readonly="readonly">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">status</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <select class="form-control" id="edt_status" name="edt_status">
                  <option value="0">DISABLE</option>
                  <option value="1">ENABLE</option>
                  <option value="2">REWARD</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">time_from</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="time_from" id="edt_time_from" name="edt_time_from"
                  value="">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">time_to</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="time_to" id="edt_time_to" name="edt_time_to"
                  value="">
              </div>
            </div>


            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">time_show_from</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="time_show_from" id="edt_time_show_from"
                  name="edt_time_show_from" value="">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">time_show_to</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="time_show_to" id="edt_time_show_to"
                  name="edt_time_show_to" value="">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">evt_copy</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="evt_copy (json)" id="edt_evt_copy"
                  name="edt_evt_copy" value="">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">file_url</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="file_url" id="edt_file_url"
                  name="edt_file_url" value="">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-2 col-xs-2">file_version</label>
              <div class="col-md-9 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="file_version" id="edt_file_version"
                  name="edt_file_version" value="">
              </div>
            </div>

            <div class="modal-footer">
              <input type="submit" class="btn btn-default" data-dismiss="modal" value="Close">
              <input type="submit" class="btn btn-primary" value="Save changes">
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>


  <div class="modal fade event-world-tour-insert-test-data-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Insert Test Data</h4>
        </div>
        <div class="modal-body">

          <form action="/config/event_world_tour_insert_test_data" method="post"
            id="event-world-tour-insert-test-data-form" data-parsley-validate class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">event_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="event_id" id="edt_event_id" name="edt_event_id"
                  value="">
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">league_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="league_id" id="edt_league_id" name="edt_league_id"
                  value="">
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">user_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="user_id" id="edt_user_id" name="edt_user_id"
                  value="">
              </div>
            </div>
            <div class="modal-footer">
              <input type="button" class="btn btn-primary" value="Add" onclick="btnInsertTestDataClicked()">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Cancel">
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>

  <div class="modal fade event-world-tour-insert-test-data-me-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Insert Test Data Me</h4>
        </div>
        <div class="modal-body">

          <form action="/config/event_world_tour_insert_test_data_me" method="post"
            id="event-world-tour-insert-test-data-me-form" data-parsley-validate class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">event_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="event_id" id="edt_event_id" name="edt_event_id"
                  value="">
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">league_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="league_id" id="edt_league_id" name="edt_league_id"
                  value="">
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">user_id</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="user_id" id="edt_user_id" name="edt_user_id"
                  value="">
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">score</label>

              <div class="col-md-6 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="score" id="edt_score" name="edt_score"
                  value="">
              </div>
            </div>
            <div class="modal-footer">
              <input type="button" class="btn btn-primary" value="Add" onclick="btnInsertTestDataMeClicked()">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Cancel">
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>


  <div class="modal fade delete_user-modal-lg" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">

        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
          </button>
          <h4 class="modal-title" id="myModalLabel">Do you want to delete?</h4>
        </div>
        <div class="modal-body">

          <form action="/config/delete_world_tour" method="post" id="delete_user-form2" data-parsley-validate
            class="form-horizontal form-label-left">

            <!-- === -->

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Event Id </label>

              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="Event Id" id="delete_edt_Id" name="delete_edt_Id"
                  value="" readonly="readonly">
              </div>
            </div>

            <div class="form-group">
              <label class="control-label col-md-2 col-sm-3 col-xs-4">Type "delete" to confirm </label>
              <div class="col-md-4 col-sm-9 col-xs-12">
                <input type="text" class="form-control" placeholder="delete" id="delete_text_confirm"
                  name="delete_text_confirm" value="">
              </div>
            </div>

            <div class="modal-footer">
              <input type="button" class="btn btn-default" data-dismiss="modal" value="Close" id="modalDelete">
              <input type="button" class="btn btn-danger" value="Delete" onclick="btnDoDeleteEvent()">
            </div>
          </form>

        </div>
      </div>
    </div>
  </div>


</section>

<script type="text/javascript">

  var btnDeleteEvent = function (serverId) {
    $('#delete_edt_Id').val($('#ds_' + serverId + '_dts_id').html());
    $('#delete_edt_device_id').val($('#ds_' + serverId + '_dts_device_id').html());
  }

  var btnDoDeleteEvent = function () {

    if ($('#delete_text_confirm').val() != 'delete') {
      alert("Please type delete to confirm you want to delete that event world tour");
      $('#delete_text_confirm').focus();
      return;
    }

    let user_id_delete = $('#delete_edt_Id').val();
    $.ajax({
      type: "POST",
      url: '/config/event_world_tour_delete',
      data: $("#delete_user-form2").serialize(),
      success: function (dataResult, textStatus, jqXHR) {
        console.log(dataResult);
        if (dataResult.status == 0) {
          $('#dataServerConfig_' + user_id_delete).remove();
          $(".delete_user-modal-lg .close").click()
          alert("Delete success");
        }
      },
      dataType: 'json'
    });
  }

