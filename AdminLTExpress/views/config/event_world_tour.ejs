  //       return 9;
  //     case "Drink_Served":
  //       return 10;
  //     default:
  //       return 0;
  //   }
  // }
  var btnEditClicked = function (serverId) {
    $('#edt_id').val($('#ds_' + serverId + '_dts_id').html());
    $('#edt_time_from').val($('#ds_' + serverId + '_dts_time_from').html());
    $('#edt_time_to').val($('#ds_' + serverId + '_dts_time_to').html());
    $('#edt_time_show_from').val($('#ds_' + serverId + '_dts_time_show_from').html());
    $('#edt_time_show_to').val($('#ds_' + serverId + '_dts_time_show_to').html());
    $('#edt_status').val($('#ds_' + serverId + '_dts_status').html());

    // $('#edt_count_by').val($('#ds_' + serverId + '_dts_count_by').html());

    // var event_type = getCountTypeByName($('#ds_' + serverId + '_dts_count_by').html());
    // $('#edt_count_by').val(event_type);

    $('#edt_evt_copy').val($('#ds_' + serverId + '_dts_evt_copy').html());
    $('#edt_file_url').val($('#ds_' + serverId + '_dts_file_url').html());
    $('#edt_file_version').val($('#ds_' + serverId + '_dts_file_version').html());
    $('#edt_status').prop('readonly', status == 2);

  }


  var onClick_btnAddNewEvent = function () {
    $('#edt_id').val(-1);
    $('#edt_time_from').val('');
    $('#edt_time_to').val('');
    $('#edt_rest_ids').val('');
    $('#edt_status').val('1');
    $('#edt_file_url').val('');
    $('#edt_file_version').val('');
    // $('#edt_prev_event_id').val('0');
    $('#edt_status').prop('readonly', false);
  }

  var btnInsertTestDataClicked = function () {
    console.log("btnInsertTestDataClicked");
    $.ajax({
      type: "POST",
      url: '/config/event_world_tour_insert_test_data',
      data: $("#event-world-tour-insert-test-data-form").serialize(),
      success: function (dataResult, textStatus, jqXHR) {
        console.log(dataResult);
        if (dataResult.status == 0) {
          $(".event-world-tour_insert_test_data-modal-lg .close").click()
          alert("success");
        }
        else {
          alert("error");
        }
      },
      dataType: 'json'
    });
  }

  var btnInsertTestDataMeClicked = function () {
    console.log("btnInsertTestDataMeClicked");
    $.ajax({
      type: "POST",
      url: '/config/event_world_tour_insert_test_data_me',
      data: $("#event-world-tour-insert-test-data-me-form").serialize(),
      success: function (dataResult, textStatus, jqXHR) {
        console.log(dataResult);
        if (dataResult.status == 0) {
          $(".event-world-tour_insert_test_data_me-modal-lg .close").click()
          alert("success");
        }
        else {
          alert("error");
        }
      },
      dataType: 'json'
    });
  }
</script>

<% include ../partial/admin_footer.ejs %>