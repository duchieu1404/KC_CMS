<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>GCC_user total_score / Changing history</h1>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="x_content">
        <br />
        <form action="/event/user_score_changed" method="post"
              data-parsley-validate class="form-horizontal form-label-left">
          <div class="form-group">
            <!-- <label class="control-label col-md-2 col-sm-3 col-xs-4">User ID</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchUserId" name="searchUserId"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.user_id%>">
            </div> -->
            <div class="col-md-6 col-sm-9 col-xs-12">
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered " style="width:100%">
          <thead>
            <tr>
              <th>No</th>
              <th>UserID</th>
              <th>Username</th>
              <th>EventID</th>
              <th>TeamID</th>
              <th>TeamName</th>
              <th>Value</th>
              <th>Reason</th>
              <th>Time</th>
              <th>Actor</th>
            </tr>
          </thead>
          <tbody>
          <% let count = 1; %>
          <% listData.forEach(function(row) { %>
            <tr>
              <td><%=count++%></td>
              <td><%= row.user_id %></td>
              <td><%= row.username %> </td>
              <td><%= row.event_id %></td>
              <td><%= row.team_id %></td>
              <td><%= row.team_name %></td>
              <td><%= row.value %></td>
              <td><%= row.reason %></td>
              <td><%= row.created_time %></td>
              <td><%= row.creator %></td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
<% include ../partial/admin_footer.ejs %>