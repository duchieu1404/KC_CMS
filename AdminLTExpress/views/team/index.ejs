<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->

<link href="/jsoneditor/dist/jsoneditor.min.css" rel="stylesheet" type="text/css">
<script src="/jsoneditor/dist/jsoneditor.min.js"></script>
<section class="content-header">
  <h1>Admin Tool<small>Search team</small></h1>
  <ol class="breadcrumb">
    <li><a href="#"><i class="fa fa-dashboard"></i>Team</a></li>
    <li class="active">Search</li>
  </ol>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="box box-info">
        <div class="box-header with-border">
          <h3 class="box-title">Search Team Form</h3>
        </div>
        <form id="demo-search_form2"
              action="/team/search_team" method="post"
              data-parsley-validate class="form-horizontal form-label-left">

          <!-- === -->

          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4" for="searchTeamId" >Team ID</label>

            <div class="col-md-3 col-sm-9 col-xs-12">
              <input id="searchTeamId" name="searchTeamId"  class="form-control " type="text" value="<%=search_form.team_id%>">
            </div>

            <label class="control-label col-md-2 col-sm-3 col-xs-4 "  for="searchTeamName" >Team Name</label>

            <div class="col-md-4 col-sm-9 col-xs-12">
              <input id="searchTeamName"  name="searchTeamName"  type="text" class="form-control " placeholder=""  value="<%=search_form.team_name%>">
            </div>
          </div>

          

          <div class="form-group">

            <label class="control-label col-md-2 col-sm-3 col-xs-4 "  for="searchLimit" >Limit</label>

            <div class="col-md-3 col-sm-9 col-xs-12">
              <input id="searchLimit"  name="searchLimit"  type="text" class="form-control " placeholder=""  value="<%=search_form.limit||100%>">
            </div>

            <label class="control-label col-md-2 col-sm-3 col-xs-4"  for="searchOffset">Offset</label>

            <div class="col-md-4 col-sm-9 col-xs-12">
              <input id="searchOffset"  name="searchOffset"  type="text" class="form-control" placeholder=""  value="<%=search_form.offset||0%>">
            </div>

            

          </div> 
          <!-- === -->

          <div class="box-footer">
            <div>
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>

        </form>

      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatableCheckbox" class="table table-striped table-bordered">
          <thead>
          <tr>  
            <th>Id</th>
            <th>Name</th>
            <th>Owner Id</th>
            <th>Owner Name</th>
            <th>Member</th>
            <th>Time Create team</th> 
            <th>Score</th>
            <th>Country</th>
            <th>Total assists team</th>
            <th>Last assists 7 days</th>
            <th>Required Star</th> 
          </tr>
          </thead>

          <tbody>
            <% listTeams.forEach(function(teamInfo) { %>
         
          <tr id = "dataServerConfig_<%= teamInfo.id %>" value_id = "<%= teamInfo.id %>">
            <td id = "ds_<%= teamInfo.id %>_dts_id"><%= teamInfo.id %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_name"><%= teamInfo.name %></td>
            <td id="ds_<%= teamInfo.id %>_dts_owner_id"><%= teamInfo.owner_id %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_owner_name"><%= teamInfo.owner_name %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_member"><%= teamInfo.member %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_time_created"><%= teamInfo.time_created %></td>
            <td id="ds_<%= teamInfo.id %>_dts_score"><%= teamInfo.score %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_country"><%= teamInfo.country %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_total_assist"><%= teamInfo.total_assist %></td>
            <td id = "ds_<%= teamInfo.id %>_dts_total_last_assist_7day"><%= teamInfo.last_assists_7_day %></td>
            <td id="ds_<%= teamInfo.id %>_dts_required_star"><%= teamInfo.require_star %></td>
          </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div> 
  </div> 
</section> 

<% include ../partial/admin_footer.ejs %>
