<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>GCC_Team score / Change Team score</h1>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="x_content">
        <br />
        <form action="/team/team_leaderboards" method="post"
              data-parsley-validate class="form-horizontal form-label-left">
          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">Event ID</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchEventId" name="searchEventId"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.event_id%>">
            </div>

            <label class="control-label col-md-2 col-sm-3 col-xs-4">Rest ID</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchRestId" name="searchRestId"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.rest_id%>">
            </div>
          </div>

          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">Page size</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchPageSize" name="searchPageSize"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.page_size || 10%>">
            </div>
            
            <div class="col-md-6 col-sm-9 col-xs-12">
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered" style="width:100%">
          <thead>
            <tr>
              <th>No</th>
              <th>TeamID</th>
              <th>TeamName</th>
              <th>TotalScore</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
          <% let count = 1; %>
          <% listUsers.forEach(function(teamInfo) { %>
            <tr>
              <td><%=count++%></td>
            
              <td><%= teamInfo.team_id %></td>
              <td><%= teamInfo.team_name %></td>
              <td><%= teamInfo.total_score %></td>
            
              <td>
                <button type="button"
                      class="btn btn-warning"
                      data-toggle="modal"
                      data-target="#adjustScoreModal"
                      onclick="btnAdjustScore( <%=teamInfo.team_id%>, '<%=teamInfo.team_name%>', <%=teamInfo.total_score%>)">
                    Update score
                </button>
                
              </td>
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- Popup sửa điểm user theo event và team -->
<div class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" id="adjustScoreModal">
  <div class="modal-dialog modal-lg" style="width:800px;">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span>
        </button>
        <h4 class="modal-title" id="myModalLabel">Adjust team score</h4>
      </div>
      <div class="modal-body">
        <form action="/team/update_user_score_by_event" method="post" id="form_data" data-parsley-validate class="form-horizontal form-label-left">
            <div class="form-group">
              <label class="control-label col-md-2">EventID</label>
              <div class="col-md-4">
                <input id="x-event-id" class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.event_id%>" readonly>
              </div>
              <label class="control-label col-md-2">RestID</label>
              <div class="col-md-4">
                <input id="x-rest-id" class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.rest_id%>" readonly>
              </div>
            </div>
            <div class="form-group">
              <label class="control-label col-md-2">TeamID</label>
              <div class="col-md-4">
                <input id="x-team-id" class="form-control col-md-5 col-xs-10" type="number" readonly>
              </div>
              <label class="control-label col-md-2">TeamName</label>
              <div class="col-md-4">
                <input id="x-team-name" class="form-control col-md-5 col-xs-10" type="text" readonly>
              </div>
            </div>
            
            <div class="form-group">
              <label class="control-label col-md-2">Current Score</label>
              <div class="col-md-4">
                <input id="x-current-score" class="form-control col-md-5 col-xs-10" type="number" readonly>
              </div>
              <label class="control-label col-md-2">Team Score <span style="color:red">*</span></label>
              <div class="col-md-4">
                <input id="x-new-score" class="form-control col-md-5 col-xs-10" type="number" placeholder="New total score of team" autofocus>
              </div>
            </div>
           
        </form>
      </div>
      <div class="modal-footer">
        <input type="button" class="btn btn-default" data-dismiss="modal" value="Close">
        <input type="submit" class="btn btn-primary" value="Save" onclick="btnSaveAdjustScore()">
      </div>
    </div>
  </div>
</div>
<script>
  function btnAdjustScore( team_id, team_name, current_score) {
    $('#x-team-id').val(team_id);
    $('#x-team-name').val(team_name);
    $('#x-current-score').val(current_score || 0);
  }

  function btnSaveAdjustScore() {
    let eventId = $('#x-event-id').val();
    let restId = $('#x-rest-id').val();
    
    let teamId = $('#x-team-id').val();
    let newScore = $('#x-new-score').val();
   
    if (!newScore) {
      alert(' New Score required');
      return;
    }
    $.ajax({
      type: "POST",
      url: '/team/update_team_score_by_event',
      data: {
        "event_id": eventId,
        "rest_id": restId,
        "team_id": teamId,
        "score": newScore,
      },
      success: function(dataResult,textStatus,jqXHR){
          location.reload(true);
      },
      error: function(dataResult,textStatus,jqXHR){
        console.log(dataResult);
      },
      dataType: 'json'
    });
    $('#adjustScoreModal').modal('hide');
  }

  function btnLockUser() {
    alert('Not supported yet!');
  }
</script>
<% include ../partial/admin_footer.ejs %>