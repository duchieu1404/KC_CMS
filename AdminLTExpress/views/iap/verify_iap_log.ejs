<% include ../partial/admin_header.ejs %>
<!-- Content Header (Page header)-->
<section class="content-header">
  <h1>IAP / IAP Logs </h1>
</section>
<!-- Main content-->

<section class="content">
  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_title">
        <div class="clearfix"></div>
      </div>

      <div class="x_content">
        <br />
        <form action="/iap/verify_iap_log" method="post"
              data-parsley-validate class="form-horizontal form-label-left">
          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">User_id</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchUserId" name="searchUserId"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.user_id%>">
            </div>

            <label class="control-label col-md-2 col-sm-3 col-xs-4">Start Time</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchStartTime" name="searchStartTime"  class="form-control col-md-5 col-xs-10" type="date" value="<%=search_form.start_time_inp%>">
            </div>
          </div>

          <div class="form-group">
            <label class="control-label col-md-2 col-sm-3 col-xs-4">End Time</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchEndTime" name="searchEndTime"  class="form-control col-md-5 col-xs-10" type="date" value="<%=search_form.end_time_inp || 10%>">
            </div>
            <label class="control-label col-md-2 col-sm-3 col-xs-4">Page size</label>
            <div class="col-md-2 col-sm-3 col-xs-4">
              <input id="searchPageSize" name="searchPageSize"  class="form-control col-md-5 col-xs-10" type="number" value="<%=search_form.page_size || 10%>">
            </div>
            
            <div class="col-md-6 col-sm-9 col-xs-12">
              <input type="submit" class="btn btn-success" value="Search"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-sm-12 col-xs-12">
    <div class="x_panel">
      <div class="x_content">
        <p class="text-muted font-13 m-b-30">
        </p>
        <table id="datatable" class="table table-striped table-bordered" style="width:100%">
          <thead>
            <tr>
              <th>No</th>
              <th>User Id</th>
              <th>Type</th>
              <th>Product id</th>
              <!-- <th>Package name</th> -->
              <th>Transaction id</th>
              <th>gps_adid</th>
              <th>idfa</th>
              <th>Revenue</th>
              <th>Currency</th>
              <th>Environment</th>
              <th>Status reponsive</th>
              <th>Create time</th>
              <!-- <th>Data reponsive</th> -->
            </tr>
          </thead>
          <tbody>
          <% let count = 1; %>
          <% listIapHistorys.forEach(function(iapHistory) { %>
            <tr>
              <td><%=count++%></td>
              <!-- iap.user_id , iap.transaction_id , iap_details.purchase_state , iap_details.purchase_failure_reason -->
              
              <td><%= iapHistory.user_id %></td>
              <td><%= iapHistory.type %></td>
              <td><%= iapHistory.product_id %></td>
              <!-- <td><%= iapHistory.package_name %></td> -->
              <td><%= iapHistory.transaction_id %></td>
              <td><%= iapHistory.gps_adid %></td>
              <td><%= iapHistory.idfa %></td>
              <td><%= iapHistory.revenue %></td>
              <td><%= iapHistory.currency %></td>
              <td><%= iapHistory.environment %></td>
              <td><%= iapHistory.status_responsive %></td>
              <td><%= iapHistory.time_created %></td>
              <!-- <td><%= iapHistory.data_responsive %></td> -->
            </tr>
          <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

 

<% include ../partial/admin_footer.ejs %>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Get all the toggle-token buttons
    var toggleButtons = document.querySelectorAll('.toggle-token');

    toggleButtons.forEach(function(button) {
      button.addEventListener('click', function() {
        // Find the sibling span with the token data
        var tokenData = this.nextElementSibling;

        // Toggle visibility
        if (tokenData.style.display === 'none') {
          tokenData.style.display = 'inline';
          this.textContent = 'Hide Token';
        } else {
          tokenData.style.display = 'none';
          this.textContent = 'Show Token';
        }
      });
    });
  });
</script>
